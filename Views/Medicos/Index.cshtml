@model IEnumerable<ClinicaVida.Web.Models.Medico>

<h2>Corpo Clínico</h2>

<form method="get">
  <select name="especialidadeId">
    <option value="">Todas as especialidades</option>
    @foreach (var e in (List<ClinicaVida.Web.Models.Especialidade>)ViewBag.Especialidades)
    {
        <option value="@e.Id">@e.Nome</option>
    }
  </select>
  <button type="submit">Filtrar</button>
</form>

<hr />

<ul>
@foreach (var medico in Model)
{
    <li>
        <a href="/Medicos/Details/@medico.Id">@medico.Nome</a>, CRM @medico.Crm
    </li>
}
</ul>